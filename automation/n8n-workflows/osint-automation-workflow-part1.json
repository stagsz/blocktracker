{
  "name": "OSINT Investigation Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "osint-investigation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "osint-investigation"
    },
    {
      "parameters": {
        "functionCode": "// Parse and validate incoming prompt data\nconst body = $input.item.json.body;\n\nconst investigationId = `${body.intelligenceType}_${body.targetName.replace(/\\s+/g, '_')}_${Date.now()}`;\n\nreturn {\n  investigationId,\n  promptData: body.promptData,\n  targetName: body.targetName,\n  intelligenceType: body.intelligenceType,\n  timestamp: body.timestamp || new Date().toISOString(),\n  phase: 'discovery'\n};"
      },
      "id": "parse-prompt",
      "name": "Parse Prompt Data",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "claude-sonnet-4-5-20250929"
            },
            {
              "name": "max_tokens",
              "value": "8000"
            },
            {
              "name": "system",
              "value": "={{ $json.systemPrompt }}"
            },
            {
              "name": "messages",
              "value": "={{ $json.messages }}"
            }
          ]
        },
        "options": {}
      },
      "id": "claude-discovery",
      "name": "Claude - Discovery Phase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 200]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook Trigger": {
      "main": [[{"node": "Parse Prompt Data", "type": "main", "index": 0}]]
    },
    "Parse Prompt Data": {
      "main": [[{"node": "Claude - Discovery Phase", "type": "main", "index": 0}]]
    }
  },
  "settings": {}
}

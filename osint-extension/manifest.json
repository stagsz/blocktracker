{
  "manifest_version": 3,
  "name": "OSINT 2.1 Intelligence Prompt Generator",
  "version": "1.0.0",
  "description": "Generate professional OSINT investigation prompts in 60 seconds. Transform your intelligence gathering with AI-powered analysis.",
  "author": "OSINT 2.1",

  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "OSINT 2.1 Prompt Generator",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },

  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://www.perplexity.ai/*",
    "https://gemini.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-scripts/claude-inject.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.openai.com/*"],
      "js": ["content-scripts/chatgpt-inject.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": ["content-scripts/perplexity-inject.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["data/*.json"],
      "matches": ["<all_urls>"]
    }
  ],

  "minimum_chrome_version": "88"
}

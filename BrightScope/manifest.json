{
  "manifest_version": 3,
  "name": "BrightScope - Intelligence Prompt Generator",
  "version": "1.0.1",
  "description": "Generate professional intelligence investigation prompts in 60 seconds. Transform your research with AI-powered analysis.",
  "author": "BrightScope",

  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "BrightScope Prompt Generator",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },

  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://www.perplexity.ai/*",
    "https://gemini.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://www.perplexity.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content-scripts/inject-sdk.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["data/*.json"],
      "matches": ["<all_urls>"]
    }
  ],

  "minimum_chrome_version": "88"
}
